# ReviewPilot Environment Configuration Template
# Copy this file to .env and supply your credentials:
# cp .env.example .env

# ==========================================
# Google Business Profile OAuth2 Integration
# ==========================================
# 1. Create a Project in Google Cloud Console: https://console.cloud.google.com/
# 2. Enable 'My Business Account Management API' and 'My Business Business Information API'
# 3. Create OAuth 2.0 Client ID (Web Application)
# 4. Set Authorized Redirect URI: http://localhost:8000/api/platforms/google/callback
#    (or https://your-production-domain.com/api/platforms/google/callback)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/platforms/google/callback

# Optional Secondary Review Platforms
YELP_API_KEY=your_yelp_fusion_api_key_here
TRIPADVISOR_API_KEY=your_tripadvisor_content_api_key_here

# Token Encryption Secret (Used to encrypt stored OAuth refresh/access tokens in SQLite)
TOKEN_ENCRYPTION_KEY=reviewpilot_super_secret_token_encryption_key_32b
BUSINESS_TIMEZONE=UTC

# ==========================================
# AI Engine Configuration (Optional)
# ==========================================
# ReviewPilot includes a high-accuracy built-in natural language engine that works out of the box with zero API keys.
# If you wish to route through Anthropic Claude 3.5 Sonnet, provide your key below:
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==========================================
# Telegram Urgent Alert Notifications (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ALERTS_ENABLED=false

# ==========================================
# Business Default Profile
# ==========================================
BUSINESS_NAME=Urban Bistro & Cafe
BUSINESS_TYPE=Restaurant / Cafe

# ==========================================
# Database & Server Configuration
# ==========================================
DATABASE_PATH=reviewpilot.db
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
JWT_SECRET_KEY=reviewpilot_super_secret_jwt_signing_key_2026_dev_prod
