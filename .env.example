# ReviewPilot Environment Configuration Template
# Copy this file to .env and supply your credentials:
# cp .env.example .env

# Anthropic Claude API Configuration (Server-Side Only)
# Obtain your API key from https://console.anthropic.com/
# If left empty, ReviewPilot automatically uses its built-in rule-based simulation engine.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Telegram Urgent Alert Notifications (Optional, Server-Side Only)
# 1. Create a bot via @BotFather on Telegram to get your BOT TOKEN
# 2. Get your CHAT ID via @userinfobot or invite bot to your channel/group
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ALERTS_ENABLED=false

# Business Default Profile (Customizable in UI)
BUSINESS_NAME=Urban Bistro & Cafe
BUSINESS_TYPE=Restaurant / Cafe

# Database Configuration (Server-Side Only)
DATABASE_PATH=reviewpilot.db

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development


