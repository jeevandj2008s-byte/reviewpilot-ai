# ReviewPilot Environment Configuration

# Anthropic Claude API Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Telegram Urgent Alert Notifications (Optional)
# 1. Create a bot via @BotFather on Telegram to get your BOT TOKEN
# 2. Get your CHAT ID via @userinfobot or invite bot to your channel/group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERTS_ENABLED=false

# Business Default Profile (can also be customized in the UI)
BUSINESS_NAME=Urban Bistro & Cafe
BUSINESS_TYPE=Restaurant / Cafe

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
